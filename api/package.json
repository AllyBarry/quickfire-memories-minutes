{
  "name": "years-in-rotation-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev ../web/dist --port 8788",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply yir --local",
    "db:migrate:remote": "wrangler d1 migrations apply yir --remote"
  },
  "dependencies": {
    "better-auth": "1.7.18",
    "hono": "4.13.17",
    "jose": "6.2.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
